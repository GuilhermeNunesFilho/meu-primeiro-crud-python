      "source": [
        "# CRUD - Manipulação de Dados\n",
        "import sqlite3\n",
        "\n",
        "# 1. Conecta ao banco (se o arquivo não existir, o Python cria ele na hora!)\n",
        "\n",
        "conexao = sqlite3.connect(\"sistema_clientes.db\")\n",
        "cursor = conexao.cursor()\n",
        "\n",
        "# 2. Cria a tabela de clientes usando SQL real\n",
        "\n",
        "cursor.execute(\"\"\"\n",
        "CREATE TABLE IF NOT EXISTS clientes (\n",
        "    id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
        "    nome TEXT NOT NULL,\n",
        "    email TEXT NOT NULL\n",
        ")\n",
        "\"\"\")\n",
        "\n",
        "# 3. Salva e fecha\n",
        "\n",
        "conexao.commit()\n",
        "conexao.close()\n",
        "\n",
        "print(\"Banco de dados e tabela criados com sucesso!\")\n"
      ]
    }
